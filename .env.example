# Copy to .env and edit if you want to override anything. Every value below is
# also the built-in default in docker-compose.yml, so `docker compose up` works
# with no .env at all.

# --- Identifiers -------------------------------------------------------------
# These are OAuth identifiers (aud / RFC 8707 resource), not addresses. Nothing
# ever fetches them. ISSUER_URL is the exception: it is both the `iss` claim and
# the base URL services use to reach the IdP inside the compose network.
ISSUER_URL=http://idp:8081
GATEWAY_RESOURCE=https://gateway.corp.internal
CONTRACTS_RESOURCE=https://mcp.corp.internal/contracts
TICKETS_RESOURCE=https://mcp.corp.internal/tickets

# --- In-network service addresses --------------------------------------------
CONTRACTS_API_URL=http://contracts-api:8091
MCP_CONTRACTS_URL=http://mcp-contracts:8092/mcp
MCP_TICKETS_URL=http://mcp-tickets:8093/mcp

# --- The switch beat 2 is about ----------------------------------------------
# true  : an MCP server refuses a token minted for a different resource.
# false : it accepts any signed token, which is the confused-deputy bug.
VALIDATE_TOKEN_RESOURCE=true

# --- Model -------------------------------------------------------------------
# ollama : talk to a real local model over the OpenAI-compatible API.
# replay : deterministic scripted stub used by CI and for recordings. It is
#          labelled "replay-stub" everywhere it appears.
MODEL_BACKEND=ollama
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_NAME=qwen3:8b

# --- Egress policy -----------------------------------------------------------
# Comma-separated recipient domains send_email will accept. Everything else is
# refused, which is what stops the injected instruction in beat 3.
EMAIL_ALLOWED_DOMAINS=corp.internal
